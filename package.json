{
  "name": "mia-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/mia-logic.test.mjs",
    "test:e2e": "playwright test --grep-invert \"@visual|@a11y\"",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "e2e:install": "playwright install --with-deps chromium",
    "lint:html": "html-validate",
    "check:sw": "node --check sw.js",
    "precommit": "lint-staged && npm run test:unit"
  },
  "lint-staged": {
    "*.html": "html-validate",
    "sw.js": "node --check sw.js",
    "assets/**/*.js": "node --check",
    "assets/**/*.mjs": "node --check",
    "tests/**/*.mjs": "node --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "1.58.2",
    "html-validate": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  }
}
